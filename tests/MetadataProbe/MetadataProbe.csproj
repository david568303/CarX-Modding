<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>MetadataProbe</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BepInExCoreDirectory Condition="'$(BepInExCoreDirectory)' == ''">$(MSBuildThisFileDirectory)../../.work/vendor/BepInEx/BepInEx/core</BepInExCoreDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="LibCpp2IL"><HintPath>$(BepInExCoreDirectory)/LibCpp2IL.dll</HintPath></Reference>
    <Reference Include="AssetRipper.Primitives"><HintPath>$(BepInExCoreDirectory)/AssetRipper.Primitives.dll</HintPath></Reference>
  </ItemGroup>
</Project>
