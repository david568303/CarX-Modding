<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>BepInEx.MetadataBootstrap</AssemblyName>
    <RootNamespace>BepInEx.MetadataBootstrap</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BepInExCoreDirectory Condition="'$(BepInExCoreDirectory)' == ''">$(MSBuildThisFileDirectory)../../.work/vendor/BepInEx/BepInEx/core</BepInExCoreDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Iced"><HintPath>$(BepInExCoreDirectory)/Iced.dll</HintPath></Reference>
  </ItemGroup>
</Project>
