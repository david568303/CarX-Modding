      VALUE "LegalCopyright", "Dobby project contributors; see LICENSE and component notices.\0"
      VALUE "License", "Apache-2.0; LLVM-derived clear-cache source: Apache-2.0 WITH LLVM-exception.\0"
      VALUE "OriginalFilename", "dobby.dll\0"
      VALUE "ProductName", "Dobby (BepInEx fork)\0"
      VALUE "ProductVersion", "1.0.5\0"
      VALUE "Comments", "https://github.com/BepInEx/Dobby; source 888d971214900374edbca6206fad6ded8a2c1311; official Windows feature profile; https://github.com/david568303/CarX-Modding\0"
